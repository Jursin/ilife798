# 统一换行符为 LF，避免跨平台（Windows CRLF / Unix LF）产生仅分隔符差异
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.zip binary
*.apk binary
*.aar binary
*.so binary
*.dex binary
*.keystore binary
*.jks binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
